# Copy this file to .env and fill in real values before running anything
# beyond a quick local demo. Every variable below is actually read
# somewhere in the codebase -- this file was generated by grepping every
# os.getenv() call, not written from memory, so it should stay accurate.

# ── Core Flask/security config ──────────────────────────────────────────
# REQUIRED for anything beyond local development. If left unset, the app
# falls back to an insecure default and prints a loud warning at startup.
# ./setup.sh generates random values for these automatically. To set them by
# hand: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=
# JWT_SECRET_KEY=

# How long an access token stays valid, in hours. Tokens used to never
# expire at all -- this is now enforced (Phase 21).
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Comma-separated list of origins allowed to call the API from a browser.
# The dev frontend runs on port 3000 (frontend/vite.config.js). Socket.IO
# enforces this list server-side, so if you open the app from any other
# host/port (e.g. a LAN IP), add that origin here or real-time features
# (messages, alerts, Ghost Mode) won't connect.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database connection string. Defaults to a local SQLite file, which is
# fine for the capstone prototype.
DATABASE_URL=sqlite:///secureai.db

# Port the Flask/Socket.IO server listens on.
PORT=5001

# Set to 1 ONLY for local development. Enables Flask's debug mode
# (interactive debugger + full stack traces on error) -- never enable
# this on anything reachable beyond your own machine.
DEBUG=0

# Advanced: force a specific Socket.IO async mode (eventlet/threading/etc).
# Leave unset unless you know you need to override the auto-detected one.
SOCKETIO_ASYNC_MODE=

# ── AI provider (governance chatbot / question bank) ────────────────────
# Which provider ai_service.py dispatches to: "gemini" (default), "openai",
# or "ollama". The app also has a TF-IDF question-bank fallback that works
# with none of these configured, so this section is optional for a basic
# demo.
AI_PROVIDER=gemini

# Used when AI_PROVIDER=gemini (the default).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used when AI_PROVIDER=openai.
OPENAI_API_KEY=

# Used when AI_PROVIDER=ollama (a local model, e.g. gemma3:4b -- see
# docs/PHASE_6_NOTES.md for how this connects to the RAG pipeline).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
